# ============================================================
# 26. SAVE ANALYTICAL TABLES
# ============================================================

zone_performance.to_csv(
    "week3_zone_performance.csv"
)

correlation_matrix.to_csv(
    "week3_correlation_matrix.csv"
)

if "vehicle_type" in df.columns and "operating_cost" in df.columns:
    vehicle_cost.to_csv(
        "week3_vehicle_cost_analysis.csv"
    )

print("\nWeek 3 analysis completed successfully.")
print("All visualizations and analytical tables have been saved.")
